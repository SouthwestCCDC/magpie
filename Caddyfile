# Magpie Artifact Storage - Caddy Configuration
#
# =============================================================================
# DEPLOYMENT MODES
# =============================================================================
#
# This configuration supports both development and production deployments:
#
# Development (docker-compose.yml):
#   - Uses :80 (no domain, no TLS)
#   - Minimal logging
#   - Admin API enabled for debugging
#
# Production (docker-compose.prod.yml):
#   - Sets MAGPIE_SITE_ADDRESS from MAGPIE_DOMAIN environment variable
#   - Automatic TLS via Let's Encrypt
#   - Enhanced security headers (HSTS, X-Frame-Options, etc.)
#   - Structured logging to stdout
#   - Admin API disabled
#
# Environment Variables:
#   MAGPIE_SITE_ADDRESS - Site address for Caddy (host[:port])
#                         Defaults to :80 for development (e.g., ":80")
#                         Set to your domain in production (e.g., "magpie.example.com")
#                         In production, docker-compose.prod.yml sets this from MAGPIE_DOMAIN
#   MAGPIE_ALLOWED_CIDRS - Comma-separated CIDR ranges for IP allow-listing
#                          (optional, for read-only access without auth)
#   AUTHENTIK_HOST - Authentik server hostname for SSO (optional, production only)
#                    See docs/authentik-setup.md for setup instructions
#   MAGPIE_ENABLE_LOGGING - Optional Caddy logging configuration block
#                           Production: set to a structured log config (e.g., JSON to stdout)
#                           Development: leave unset for minimal logging
#   MAGPIE_DISABLE_ADMIN - Optional admin API configuration directive
#                          Production: set to "admin off" to disable Caddy's admin API
#                          Development: leave unset to keep admin API enabled for debugging
#   MAGPIE_PROD_SECURITY_HEADERS - Optional production-only security headers block
#                                  Development: leave unset
#                                  Production: set to a multi-line header configuration
#   MAGPIE_TLS_CONFIG - Optional TLS configuration directive
#                       Defaults to automatic Let's Encrypt when using a domain
#                       For manual certs: e.g., "tls /path/to/cert.pem /path/to/key.pem"
#                       For internal CA: e.g., "tls internal"
#
# =============================================================================
# AUTHENTICATION FLOW (forward_auth)
# =============================================================================
#
# Magpie supports two authentication methods:
#
# 1. BEARER TOKENS (for API access):
#    Protected routes use Caddy's forward_auth to validate Bearer tokens:
#
#    a. Client sends request with "Authorization: Bearer <token>" header
#    b. Caddy makes subrequest to /api/v1/auth/validate with the same headers
#    c. Auth endpoint validates token and returns:
#       - 200 OK with X-Magpie-User and X-Magpie-Scope headers (valid token)
#       - 401 Unauthorized (invalid/missing token)
#    d. If auth returns 200, Caddy copies identity headers to upstream request
#    e. If auth returns 401, Caddy returns 401 to client (request blocked)
#
# 2. AUTHENTIK SSO (for browser access to /artifacts/*, production only):
#    When AUTHENTIK_HOST is set in production, users browsing /artifacts/* are
#    authenticated via Authentik SSO:
#
#    a. Browser requests /artifacts/*
#    b. Caddy sends request to Authentik forward auth endpoint
#    c. If no valid session, Authentik redirects browser to login page
#    d. After login, Authentik validates session and returns user headers:
#       - X-authentik-username, X-authentik-email, X-authentik-name
#    e. Caddy forwards request with user identity headers
#
#    See docs/authentik-setup.md for complete setup instructions.
#
# =============================================================================
# ROUTE PROTECTION SUMMARY
# =============================================================================
#
# PROTECTED ROUTES (require valid Bearer token):
#   - POST   /api/v1/upload/*                            - Artifact uploads
#   - GET    /api/v1/artifacts/*                         - List artifacts, get info
#   - POST   /api/v1/artifacts/{path}/{ref}/tags         - Add tags to artifact
#   - DELETE /api/v1/artifacts/{path}/tags/{tag_name}    - Remove tags from artifact
#   - POST   /api/v1/tags/{tag_name}/flush               - Flush tags globally
#   - GET    /api/v1/tokens                              - List tokens (admin)
#   - POST   /api/v1/tokens                              - Create tokens (admin)
#   - DELETE /api/v1/tokens/*                            - Revoke tokens (admin)
#   - POST   /api/v1/gc                                  - Garbage collection (admin)
#   - GET    /api/v1/status                              - Server status (admin)
#   - GET    /artifacts/*                                - Static file downloads (except /artifacts/public/*)
#
# Note: GET routes may bypass authentication for IPs in MAGPIE_ALLOWED_CIDRS
# (see IP ALLOW-LISTING section below)
#
# PUBLIC ROUTES (no authentication required):
#   - GET    /api/v1/auth/validate         - Auth validation endpoint
#   - GET    /health                       - Health check
#   - GET    /artifacts/public/*           - Public static file downloads
#
# =============================================================================
# HEADER PROPAGATION
# =============================================================================
#
# On successful authentication, these headers are copied to upstream:
#
# Bearer Token Authentication:
#   - X-Magpie-User:  Token name (identifies the authenticated client)
#   - X-Magpie-Scope: Permission level (read, write, or admin)
#
# Authentik SSO Authentication (when enabled in production):
#   - X-authentik-username: Authentik username
#   - X-authentik-email:    User's email address
#   - X-authentik-name:     User's display name
#
# The FastAPI backend can use these headers for authorization decisions and logging.
#
# =============================================================================
# IP ALLOW-LISTING (READ-ONLY ACCESS)
# =============================================================================
#
# Environment variable configuration:
#   MAGPIE_ALLOWED_CIDRS - Comma-separated list of CIDR ranges allowed to bypass
#                          bearer token authentication for READ-ONLY operations
#                          (e.g., "10.0.0.0/8,192.168.1.0/24")
#                          Default: empty (no IP exemptions)
#
# When MAGPIE_ALLOWED_CIDRS is set, requests from these IP ranges can access
# READ operations without a bearer token:
#   - GET /api/v1/artifacts*  (list artifacts, get metadata)
#   - GET /artifacts/*        (download artifact files)
#
# WRITE and ADMIN operations ALWAYS require a valid bearer token, even from
# allowed IPs:
#   - POST /api/v1/upload/*                            (uploads)
#   - PATCH /api/v1/artifacts/*                        (metadata amendments)
#   - POST /api/v1/artifacts/{path}/{ref}/tags         (add tags)
#   - DELETE /api/v1/artifacts/{path}/tags/{tag_name}  (remove tags)
#   - POST /api/v1/tags/{tag_name}/flush               (tag flushing)
#   - POST/DELETE /api/v1/tokens*                      (token management)
#   - POST /api/v1/gc                                  (garbage collection)
#
# This is useful for:
#   - Internal monitoring and alerting systems
#   - CI/CD pipelines downloading artifacts on trusted networks
#   - Read-only infrastructure tools
#
# SECURITY NOTE: Only add trusted network ranges. IPs in the allowed list
# can read all artifacts without authentication.
#
# =============================================================================

# Global options block
{
	# Production logging (optional - enabled only when MAGPIE_ENABLE_LOGGING is set)
	# Development: keep MAGPIE_ENABLE_LOGGING unset (no structured logging)
	# Production: set MAGPIE_ENABLE_LOGGING to a Caddy log configuration block (e.g., JSON to stdout)
	{$MAGPIE_ENABLE_LOGGING}

	# Admin API configuration (optional - injected as a Caddy directive when set)
	# Development: keep MAGPIE_DISABLE_ADMIN unset (admin API enabled for debugging)
	# Production: set MAGPIE_DISABLE_ADMIN="admin off" to disable the admin API for security
	{$MAGPIE_DISABLE_ADMIN}

	servers {
		trusted_proxies static private_ranges
	}
}

# Site address - controlled via MAGPIE_SITE_ADDRESS, defaults to :80 for dev
# Development: MAGPIE_SITE_ADDRESS=":80"
# Production: MAGPIE_SITE_ADDRESS="magpie.example.com"
{$MAGPIE_SITE_ADDRESS::80} {
	# =========================================================================
	# TLS CONFIGURATION (Production only)
	# =========================================================================
	#
	# TLS is automatic via Let's Encrypt when MAGPIE_SITE_ADDRESS is a domain name
	# (e.g., magpie.example.com). In production, MAGPIE_SITE_ADDRESS is typically
	# set from MAGPIE_DOMAIN.
	# For manual certificates, set MAGPIE_TLS_CONFIG:
	#   MAGPIE_TLS_CONFIG="tls /path/to/cert.pem /path/to/key.pem"
	#
	# For internal CA (self-signed):
	#   MAGPIE_TLS_CONFIG="tls internal"
	{$MAGPIE_TLS_CONFIG}

	# =========================================================================
	# SECURITY HEADERS
	# =========================================================================

	header {
		# Production-only security headers (enabled when MAGPIE_PROD_SECURITY_HEADERS is set)
		# Development: keep MAGPIE_PROD_SECURITY_HEADERS unset
		# Production: set MAGPIE_PROD_SECURITY_HEADERS to multi-line header config
		{$MAGPIE_PROD_SECURITY_HEADERS}

		# Content Security Policy - restrict resource loading (always enabled)
		# Note: 'unsafe-inline' is safe here because Content-Disposition: attachment
		# prevents uploaded HTML from rendering, so only Caddy's browse template executes
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}

	# =========================================================================
	# PUBLIC ROUTES - No authentication required
	# =========================================================================

	# Health check endpoint - used by container orchestration
	handle /health {
		reverse_proxy magpie:8000
	}

	# Auth validation endpoint - must be public (used by forward_auth itself)
	handle /api/v1/auth/validate {
		reverse_proxy magpie:8000
	}

	# Public artifacts - no authentication required
	# Files placed in /data/artifacts/public/ are accessible without auth
	handle /artifacts/public/* {
		root * /data
		# Security: Force download of artifact files to prevent XSS from user-uploaded HTML/JS
		# Use matcher to apply header only to actual file responses, not browse template pages
		@public_artifact_file {
			file {
				try_files {path}
			}
		}
		header @public_artifact_file Content-Disposition "attachment"
		file_server browse
	}

	# =========================================================================
	# PROTECTED ROUTES - Require valid Bearer token via forward_auth
	# =========================================================================

	# Artifact read operations (GET only) - requires valid Bearer token OR allowed IP
	# Matches: GET /api/v1/artifacts, GET /api/v1/artifacts/{path}, GET /api/v1/artifacts/{path}/{ref}/info
	# Note: POST/DELETE to /artifacts/*/tags* are handled separately below
	@artifacts_read {
		method GET
		path /api/v1/artifacts*
	}
	handle @artifacts_read {
		# Define matchers for allowed vs non-allowed IPs
		@allowed_ip {
			client_ip {$MAGPIE_ALLOWED_CIDRS:255.255.255.255/32}
		}
		@require_auth {
			not client_ip {$MAGPIE_ALLOWED_CIDRS:255.255.255.255/32}
		}
		# For allowed IPs: strip client headers and inject synthetic ones (forward_auth skipped)
		request_header @allowed_ip -X-Magpie-User
		request_header @allowed_ip -X-Magpie-Scope
		request_header @allowed_ip X-Magpie-User "cidr-bypass"
		request_header @allowed_ip X-Magpie-Scope "read"
		# For non-allowed IPs: run forward_auth to get real headers
		forward_auth @require_auth magpie:8000 {
			uri /api/v1/auth/validate
			copy_headers X-Magpie-User X-Magpie-Scope
		}
		reverse_proxy magpie:8000
	}

	# Protected artifact downloads - requires valid Bearer token OR allowed IP
	# Static files accessed via /artifacts/{artifact_path}/{ref} symlinks
	# Directory browsing enabled for discovery and debugging
	#
	# SECURITY NOTE: Directory browsing exposes the artifact structure (paths,
	# refs, filenames) to authenticated users. If you need to restrict
	# browsing, remove the "browse" argument from file_server below.
	#
	# AUTHENTIK SSO INTEGRATION (OPTIONAL, PRODUCTION ONLY):
	# To enable Authentik SSO for human browser access in addition to Bearer
	# tokens, set this environment variable:
	#   - AUTHENTIK_HOST: The Authentik server hostname (e.g., authentik.example.com)
	#
	# When enabled, users browsing /artifacts/* via web browser will be redirected
	# to Authentik for authentication. Bearer token access via API continues to work.
	#
	# To enable Authentik SSO instead of Bearer auth, replace the forward_auth
	# block below with:
	#     # Strip client-provided auth headers (defense-in-depth)
	#     request_header -X-authentik-username
	#     request_header -X-authentik-email
	#     request_header -X-authentik-name
	#     request_header -X-authentik-groups
	#
	#     forward_auth {$AUTHENTIK_HOST} {
	#         uri /outpost.goauthentik.io/auth/caddy
	#         copy_headers X-authentik-username X-authentik-email X-authentik-name X-authentik-groups
	#     }
	handle /artifacts/* {
		# Define matcher for non-allowed IPs (allowed IPs bypass auth check)
		@require_auth {
			not client_ip {$MAGPIE_ALLOWED_CIDRS:255.255.255.255/32}
		}
		# For non-allowed IPs: run forward_auth to validate token
		# Note: Caddy's file_server serves static files directly; no headers are
		# forwarded to the backend, so we don't inject synthetic headers for allowed IPs
		forward_auth @require_auth magpie:8000 {
			uri /api/v1/auth/validate
			copy_headers X-Magpie-User X-Magpie-Scope
		}
		root * /data
		# Security: Force download of artifact files to prevent XSS from user-uploaded HTML/JS
		# Use matcher to apply header only to actual file responses, not browse template pages
		@artifact_file {
			file {
				try_files {path}
			}
		}
		header @artifact_file Content-Disposition "attachment"
		file_server browse
	}

	# Upload endpoint - requires write or admin scope
	handle /api/v1/upload/* {
		forward_auth magpie:8000 {
			uri /api/v1/auth/validate
			copy_headers X-Magpie-User X-Magpie-Scope
		}
		reverse_proxy magpie:8000
	}

	# Artifact metadata amendment - requires write or admin scope
	# Matches: PATCH /api/v1/artifacts/{path}/{ref}
	# Note: Uses path_regexp because artifact paths can have multiple segments
	@artifacts_amend {
		method PATCH
		path_regexp ^/api/v1/artifacts/.+
	}
	handle @artifacts_amend {
		forward_auth magpie:8000 {
			uri /api/v1/auth/validate
			copy_headers X-Magpie-User X-Magpie-Scope
		}
		reverse_proxy magpie:8000
	}

	# Tag mutation endpoints - requires write or admin scope
	# Matches: POST /api/v1/artifacts/{path}/{ref}/tags
	#          DELETE /api/v1/artifacts/{path}/tags/{tag_name}
	# Note: Uses path_regexp because artifact paths can have multiple segments
	# (e.g., /api/v1/artifacts/test/artifact/@abc12345/tags)
	@artifacts_tags {
		method POST DELETE
		path_regexp ^/api/v1/artifacts/.+/tags
	}
	handle @artifacts_tags {
		forward_auth magpie:8000 {
			uri /api/v1/auth/validate
			copy_headers X-Magpie-User X-Magpie-Scope
		}
		reverse_proxy magpie:8000
	}

	# Flush tag endpoint - requires admin scope
	# Matches: POST /api/v1/tags/{tag_name}/flush
	@tags_flush {
		method POST
		path /api/v1/tags/*/flush
	}
	handle @tags_flush {
		forward_auth magpie:8000 {
			uri /api/v1/auth/validate
			copy_headers X-Magpie-User X-Magpie-Scope
		}
		reverse_proxy magpie:8000
	}

	# Token management endpoints - requires admin scope
	handle /api/v1/tokens* {
		forward_auth magpie:8000 {
			uri /api/v1/auth/validate
			copy_headers X-Magpie-User X-Magpie-Scope
		}
		reverse_proxy magpie:8000
	}

	# GC endpoint - requires admin scope
	handle /api/v1/gc {
		forward_auth magpie:8000 {
			uri /api/v1/auth/validate
			copy_headers X-Magpie-User X-Magpie-Scope
		}
		reverse_proxy magpie:8000
	}

	# Status endpoint - requires admin scope
	handle /api/v1/status {
		forward_auth magpie:8000 {
			uri /api/v1/auth/validate
			copy_headers X-Magpie-User X-Magpie-Scope
		}
		reverse_proxy magpie:8000
	}

	# =========================================================================
	# ROOT LANDING PAGE
	# =========================================================================

	# Redirect root to artifact browser
	handle / {
		redir * /artifacts/ permanent
	}

	# =========================================================================
	# FALLBACK
	# =========================================================================

	# Return 404 for unmatched routes
	handle {
		respond "Not Found" 404
	}
}
