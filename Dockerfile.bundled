# syntax=docker/dockerfile:1
#
# Magpie bundled single-container image (#309 Phase 1, issue #586).
#
# Bundles Caddy (internal auth gate / static server, see
# docker/bundled/Caddyfile) and uvicorn into a single image. wrapper.sh
# itself is PID 1 (ENTRYPOINT): it runs a brief root prelude (the on-disk
# ownership fixups only root can do), then inserts tini -- dropped to the
# non-root runtime uid via gosu in the same exec -- so tini itself ends
# up PID 1, non-root, rather than tini running as root in front of a
# dropped child (issue #591: that cross-uid relationship was the last
# thing requiring CAP_KILL, since root-tini forwarding a signal to its
# non-root child is a different-uid kill()). tini then forks wrapper.sh
# again as its child, same uid throughout, which starts both processes
# in order (uvicorn first, then Caddy once uvicorn answers /health),
# fails the whole container fast if either process exits on its own, and
# drains both cleanly on SIGTERM/`docker stop`. In the normal case (the
# resolved runtime uid is non-root), NO process in this container runs
# as root in steady state, tini included; if that uid resolves to 0
# (e.g. a fresh, still-root-owned volume with no MAGPIE_UID set),
# wrapper.sh's documented fallback is to keep tini and everything else
# running as root instead, same as entrypoint.sh's own "no privilege
# drop needed" case.
#
# Externally the container exposes one plain-HTTP port (8080, non-
# privileged so Caddy can run non-root -- see issue #589); TLS
# termination is left to whatever reverse proxy fronts it.
#
# This does not replace the two-container docker-compose.prod.yml topology
# yet (see #561 for the migration); it is the image only. entrypoint.sh
# (that topology's ENTRYPOINT) is intentionally NOT used here -- wrapper.sh
# has its own self-contained root prelude, duplicating a small amount of
# entrypoint.sh's setup logic rather than sharing it, so entrypoint.sh's
# contract for the two-container image can't be affected by this image's
# supervisor design (#591).

# 2.11.2+ required: GHSA-7r4p-vjf4-gxv4 (CVE-2026-30851, CVSS 8.1) affects
# v2.10.0-v2.11.1. #525's X-Magpie-* header strip treats "the inner Caddy
# runs a patched build" as a load-bearing invariant.
ARG CADDY_VERSION=2.11.4

FROM caddy:${CADDY_VERSION}-alpine AS caddy-src

# Strip the cap_net_bind_service file capability the upstream Caddy image
# sets on the binary (so Caddy can bind :80 without running as root).
# Unneeded here since Caddy binds :8080, non-root, instead (#589) -- and
# leaving it in place is actively harmful, not just unused: execve()
# refuses to run a binary whose file capabilities exceed the calling
# process's capability bounding set (EPERM), so under a container with
# CAP_NET_BIND_SERVICE dropped, Caddy would fail to start at all rather
# than simply not using the capability.
#
# Done here, in the alpine builder stage, rather than after the COPY into
# the runtime stage: setcap rewrites the binary's xattrs, which on an
# overlayfs COPY --from triggers a copy-up -- stripping post-COPY leaves
# the original (with-capability) copy sitting in the COPY layer AND the
# stripped copy in this RUN's layer, permanently doubling the ~48MB
# binary's footprint in the final image. Stripping before the COPY means
# only the already-stripped binary is ever copied into the runtime stage.
RUN apk add --no-cache libcap-utils && \
    setcap -r /usr/bin/caddy && \
    apk del libcap-utils

FROM python:3.13-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
WORKDIR /app
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Install dependencies (cached layer)
FROM base AS deps
COPY pyproject.toml uv.lock* ./
RUN uv sync --frozen --no-dev --no-install-project

# Final image
FROM base AS runtime
COPY --from=deps /app/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH"

# gosu (wrapper.sh's root-prelude privilege drop), tini (PID 1), curl
# (healthcheck.sh + AWS CLI installer below), wget (wrapper.sh's readiness
# poll), unzip (AWS CLI installer, purged again below)
# hadolint ignore=DL3008
RUN apt-get update && \
    apt-get install -y --no-install-recommends gosu tini curl wget ca-certificates unzip && \
    rm -rf /var/lib/apt/lists/* && \
    gosu nobody true && gosu 1000:1000 true

# Install AWS CLI v2 for S3 sync operations (multi-arch support)
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
        amd64) aws_arch="x86_64" ;; \
        arm64) aws_arch="aarch64" ;; \
        *) echo "Unsupported architecture for AWS CLI: $arch" >&2; exit 1 ;; \
    esac; \
    curl -fsS "https://awscli.amazonaws.com/awscli-exe-linux-${aws_arch}.zip" -o "awscliv2.zip" && \
    unzip awscliv2.zip && \
    ./aws/install && \
    rm -rf awscliv2.zip aws && \
    apt-get purge -y unzip && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*

# Caddy binary, copied from the official Caddy alpine image (already
# stripped of its cap_net_bind_service file capability in the caddy-src
# stage above)
COPY --from=caddy-src /usr/bin/caddy /usr/bin/caddy

COPY src/ ./src/
COPY pyproject.toml uv.lock README.md ./

# Install the project itself
RUN uv sync --frozen --no-dev

# `uv sync` installs magpie-ctl's own console-script entry point at
# /app/.venv/bin/magpie-ctl (from pyproject.toml's [project.scripts]).
# Removed: PATH puts /app/.venv/bin ahead of /usr/local/bin (see ENV PATH
# above), so a bare `magpie-ctl` on PATH would resolve to this raw binary
# INSTEAD OF /usr/local/bin/magpie-ctl (the privilege-dropping wrapper
# below) -- silently bypassing it for any `docker exec <container>
# magpie-ctl ...` invocation (root, no gosu drop) while still appearing
# to work, since unrestricted root's implicit DAC_OVERRIDE masks the
# wrong uid. Every documented `docker exec ... magpie-ctl` usage (see
# docs/, deployment/README.md, scripts/magpie-deploy.sh) depends on the
# wrapper actually being what bare `magpie-ctl` resolves to.
RUN rm /app/.venv/bin/magpie-ctl

# Wrapper for magpie-ctl that drops privileges when invoked via docker exec
# (reads /run/magpie-user, written by wrapper.sh's root prelude -- not
# entrypoint.sh, which this image doesn't use; see the top-of-file note)
COPY magpie-ctl-wrapper.sh /usr/local/bin/magpie-ctl
RUN chmod +x /usr/local/bin/magpie-ctl

COPY docker/bundled/Caddyfile /etc/caddy/Caddyfile
COPY docker/bundled/healthcheck.sh /usr/local/bin/healthcheck.sh
COPY docker/bundled/wrapper.sh /wrapper.sh
RUN chmod +x /usr/local/bin/healthcheck.sh /wrapper.sh

EXPOSE 8080

# start-period covers the worst-case cold start: wrapper.sh's startup gate
# waits up to 60s for uvicorn to answer /health, and wrapper.sh's own
# first-boot DB init can itself block up to 30s on `flock -x -w 30` (e.g.
# concurrent container starts racing for /data) before uvicorn is even
# started -- ~90s worst case, plus a small buffer.
HEALTHCHECK --interval=10s --timeout=5s --start-period=95s --retries=3 \
    CMD ["/usr/local/bin/healthcheck.sh"]

ENTRYPOINT ["/wrapper.sh"]
