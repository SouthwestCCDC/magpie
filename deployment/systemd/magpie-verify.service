# Magpie Integrity Verification (Scrub) Service
# This oneshot service runs magpie-ctl verify to re-read stored blobs and
# compare them against the SHA-256 recorded at upload time, detecting bit-rot
# or tampering of artifacts (e.g., OpenVPN CA/cert/key material).
# Triggered by magpie-verify.timer (recommended) or can be run manually.
#
# Installation:
#   cp magpie-verify.service /etc/systemd/system/
#   cp magpie-verify.timer /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now magpie-verify.timer
#
# Manual run:
#   systemctl start magpie-verify.service
#
# View logs (including any integrity findings):
#   journalctl -u magpie-verify.service
#
# Exit codes: 0 clean, 1 operational error, 3 missing blob/metadata,
# 5 content mismatch, 75 the run was skipped because a lock was held. A failed
# unit state means the scrub found something, except for 75: that run never
# started, so storage was not checked at all. Alert on a repeated 75 (the
# schedule is never getting a turn), not on a single one.
# See docs/monitoring.md for alerting guidance.

[Unit]
Description=Magpie Integrity Verification
Documentation=https://github.com/SouthwestCCDC/magpie
After=network.target docker.service magpie.service
Requires=docker.service

[Service]
Type=oneshot

# Run verification via Docker Compose with flock-based locking.
# Uses a dedicated lock file so a scrub never overlaps with another scrub, and
# the GC lock is also taken because GC unlinks a blob before its metadata
# sidecar: a scrub racing GC can otherwise report a collected blob as missing.
# The GC lock uses a bounded wait (-w 3600) so an overrunning collection delays
# the scrub instead of cancelling it, and both locks use `-E 75` so a run that
# never started is distinguishable from a scrub that failed on broken storage.
# Uses `docker compose exec` into the RUNNING magpie container. This requires
# the container to be up (verification fails loudly if the service is stopped
# when this unit triggers) -- but it is the only form that works with the
# v0.2.0+ bundled single-container image, whose entrypoint is a process
# supervisor that ignores its arguments: `docker compose run magpie
# magpie-ctl verify` there boots a second server that never exits, so verify
# never runs and the oneshot blocks until TimeoutStartSec.
# Adjust path to match your installation.
WorkingDirectory=/opt/magpie
#
# After= only orders unit START, and magpie.service is Type=simple running
# `docker compose up`, so it counts as started long before the container is
# serving. With magpie-verify.timer's Persistent=true, a missed run is replayed
# at boot, where the exec below would otherwise race the container coming up.
# So wait (bounded) for the container to report healthy first -- the image's
# HEALTHCHECK covers uvicorn answering /health, which implies the entrypoint's
# DB init finished. 5 minutes, then fail loudly rather than hang until
# TimeoutStartSec; the next scheduled run recovers on its own since a full scrub
# is read-only and does not depend on a previous run completing.
#
# `docker inspect` rather than `compose ps --format <go-template>`: the
# template form of `ps` needs a recent Compose v2, and an image with no
# HEALTHCHECK reports an empty .State.Health, which is distinguishable here
# but not through `ps` -- so that case exits nonzero at once with a real
# message instead of burning the whole 300s bound waiting for a status that
# can never arrive. No container yet (empty `ps -q`) keeps waiting:
# magpie.service may still be creating it.
#
# The magpie.service check up front is what separates "coming up" from
# "deliberately stopped": during planned downtime the container never appears,
# and without it every timer firing would sit here for the full 300s and then
# report a bare exit 124. Ordering means magpie.service has already been
# started when this runs, so "not active" is a real answer, not a race.
# It is conditional on the unit EXISTING (`systemctl cat`) because this file is
# also copied on its own, without magpie.service, for a stack brought up by a
# hand-run `docker compose up -d` or a differently-named unit -- there, only
# the container wait below applies, exactly as before.
#
# Drop this ExecStartPre entirely if you switch to the Direct execution
# alternative below: it is specific to `exec` into a healthy bundled container.
ExecStartPre=/usr/bin/timeout 300 /bin/sh -c 'if /usr/bin/systemctl cat magpie.service >/dev/null 2>&1 && ! /usr/bin/systemctl is-active --quiet magpie.service; then echo "magpie.service is not active; not running scrub (start it to resume scheduled scrubs)" >&2; exit 1; fi; while :; do cid=$(/usr/bin/docker compose ps -q magpie 2>/dev/null); if [ -n "$cid" ]; then state=$(/usr/bin/docker inspect -f "{{if .State.Health}}{{.State.Health.Status}}{{else}}nohealthcheck{{end}}" "$cid" 2>/dev/null); case "$state" in healthy) exit 0 ;; nohealthcheck) echo "magpie container has no HEALTHCHECK; cannot confirm readiness before verify" >&2; exit 1 ;; esac; fi; sleep 5; done'
ExecStart=/usr/bin/flock -n -E 75 /var/run/magpie-verify.lock /usr/bin/flock -w 3600 -E 75 /var/run/magpie-gc.lock /usr/bin/docker compose exec -T magpie magpie-ctl verify --quiet

# Alternative: scope the scrub to competition-critical crypto material only,
# which is cheap enough to run daily even on a large store.
# ExecStart=/usr/bin/flock -n -E 75 /var/run/magpie-verify.lock /usr/bin/flock -w 3600 -E 75 /var/run/magpie-gc.lock /usr/bin/docker compose exec -T magpie magpie-ctl verify --path openvpn --quiet

# Alternative: bound the work of each run. NOTE: the walk always starts at the
# beginning of the store and keeps no cursor, so a bounded run repeatedly covers
# the same head of the store rather than rolling forward. Prefer --path scoping
# to cover the whole store in pieces.
# ExecStart=/usr/bin/flock -n -E 75 /var/run/magpie-verify.lock /usr/bin/flock -w 3600 -E 75 /var/run/magpie-gc.lock /usr/bin/docker compose exec -T magpie magpie-ctl verify --max-bytes 10737418240 --quiet

# Alternative: Direct execution (if not using Docker)
# Delete the ExecStartPre= line above if you use this -- there is no container
# to wait for.
# ExecStart=/usr/bin/flock -n -E 75 /var/run/magpie-verify.lock /usr/bin/flock -w 3600 -E 75 /var/run/magpie-gc.lock /usr/local/bin/magpie-ctl verify --quiet

# User configuration (optional)
# By default, this service runs as root. To run as a different user, uncomment
# and set User= to a user with Docker socket access (typically in 'docker' group).
# User=magpie

# Environment overrides (optional)
# NOTE: For Docker deployments using `docker compose exec`, these environment
# variables are NOT passed to the container. Configure settings in the
# container's .env file or docker-compose.yml, or use CLI flags instead.
# These Environment= lines only apply when using direct execution (non-Docker).
# Environment=MAGPIE_STORAGE_PATH=/data/artifacts

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=magpie-verify

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

# Allow write access to lock file directory (/var/run is typically a symlink to /run)
ReadWritePaths=/var/run
# If using direct execution, also add read access to the storage path:
# ReadWritePaths=/data/artifacts
#
# NOTE: ProtectHome=true and ProtectSystem=strict may prevent access to
# MAGPIE_DATA_DIR if configured to paths in /home or other protected locations.

# Timeouts
# A full scrub re-reads every byte in storage; raise this or bound the run with
# --path/--limit/--max-bytes for large stores. The budget must also cover the
# GC-lock wait above (-w 3600), which is spent before the scrub starts.
TimeoutStartSec=21600
