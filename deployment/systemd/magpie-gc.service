# Magpie Garbage Collection Service
# This oneshot service runs magpie-ctl gc to clean up untagged blobs.
# Triggered by magpie-gc.timer (recommended) or can be run manually.
#
# Installation:
#   cp magpie-gc.service /etc/systemd/system/
#   cp magpie-gc.timer /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now magpie-gc.timer
#
# Manual run:
#   systemctl start magpie-gc.service
#
# View logs:
#   journalctl -u magpie-gc.service

[Unit]
Description=Magpie Garbage Collection
Documentation=https://github.com/SouthwestCCDC/magpie
After=network.target docker.service magpie.service
Requires=docker.service

[Service]
Type=oneshot

# Run GC via Docker Compose with flock-based locking
# Uses `flock -n` to prevent concurrent runs. If GC is already running, flock
# exits immediately with a non-zero status. Unlike ConditionPathExists, flock
# automatically handles stale lock files from crashed processes.
# Uses `docker compose exec` into the RUNNING magpie container. This requires
# the container to be up (GC fails loudly if the service is stopped when this
# unit triggers) -- but it is the only form that works with the v0.2.0+
# bundled single-container image, whose entrypoint is a process supervisor
# that ignores its arguments: `docker compose run magpie magpie-ctl gc` there
# boots a second server that never exits, so GC never runs and the oneshot
# blocks until TimeoutStartSec.
# Adjust path to match your installation.
WorkingDirectory=/opt/magpie
ExecStart=/usr/bin/flock -n /var/run/magpie-gc.lock /usr/bin/docker compose exec -T magpie magpie-ctl gc --quiet

# Alternative (pre-0.2.0 two-container topology ONLY -- see above): a one-off
# container, which also works while the main container is stopped.
# ExecStart=/usr/bin/flock -n /var/run/magpie-gc.lock /usr/bin/docker compose run --rm -T magpie magpie-ctl gc --quiet

# Alternative: Direct execution (if not using Docker)
# ExecStart=/usr/bin/flock -n /var/run/magpie-gc.lock /usr/local/bin/magpie-ctl gc --quiet

# User configuration (optional)
# By default, this service runs as root. To run as a different user, uncomment
# and set User= to a user with Docker socket access (typically in 'docker' group).
# User=magpie

# Environment overrides (optional)
# NOTE: For Docker deployments using `docker compose run`, these environment
# variables are NOT passed to the container. Configure settings in the
# container's .env file or docker-compose.yml, or use CLI flags instead
# (e.g., --retention-days 30). These Environment= lines only apply when
# using direct execution (non-Docker).
# Environment=MAGPIE_RETENTION_DAYS=30
# Environment=MAGPIE_STORAGE_PATH=/data/artifacts

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=magpie-gc

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

# Allow write access to lock file directory (/var/run is typically a symlink to /run)
ReadWritePaths=/var/run
# If using direct execution, also add:
# ReadWritePaths=/data/artifacts
#
# NOTE: ProtectHome=true and ProtectSystem=strict may prevent access to
# MAGPIE_DATA_DIR if configured to paths in /home or other protected locations.
# If you encounter permission errors, either:
#   1. Use a non-protected path like /opt/magpie/data or /var/lib/magpie
#   2. Adjust security settings (e.g., ProtectHome=false or add ReadWritePaths)

# Timeouts
# GC can take a while for large storage; adjust as needed
TimeoutStartSec=3600
